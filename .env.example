# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Strava -----------------------------------------------------------------
# Create your own API application at https://www.strava.com/settings/api
#   Application Name:      anything
#   Category:              Training
#   Website:               http://localhost
#   Authorization Callback Domain:  localhost      <- must be exactly this
# Then copy the two values it shows you.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Garmin -----------------------------------------------------------------
# Your normal Garmin Connect login. Used once, to mint tokens that are then
# stored in .secrets/garmin/ and reused for about a year.
# Leave these blank if you would rather be prompted interactively.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Preferences ------------------------------------------------------------
UNITS=imperial          # imperial | metric
